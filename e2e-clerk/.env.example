# Copy to .env (gitignored) and fill in. Never commit real values.

# Target: the isolated Clerk staging deployment (default) or local dev.
BASE_URL=https://basarai-clerk-staging.onrender.com

# Clerk test users, created out-of-band via the Backend API with a
# pre-verified email + password (see docs/clerk-migration-plan.md /
# session notes for how they were provisioned). Never real user accounts.
TEST_USER_EMAIL=e2e-clerk-test@example.com
TEST_USER_PASSWORD=

# Real email configured in the deployed ADMIN_EMAILS allow-list on
# basarai-clerk-staging. Used to verify admin authorization via password
# login (a Clerk user with this email + password was also provisioned
# out-of-band). Leave unset to skip the admin test.
ADMIN_TEST_EMAIL=
ADMIN_TEST_PASSWORD=

# Set to "false" to skip the real OpenAI generation test.
RUN_GENERATION_TEST=true
