# Supabase Configuration (Client-side)
# Local:  http://127.0.0.1:54321 (via `supabase start`)
# Hosted: https://<project-ref>.supabase.co (from dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# API Configuration
NEXT_PUBLIC_API_URL=/api
NEXT_SERVER_API_URL=http://127.0.0.1:8000

# Canonical public app URL (used for auth redirects -- emailRedirectTo and
# the /auth/confirm route). Must match how you actually access the app:
# Local:  http://localhost:3000
# Hosted: https://<your-deployed-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
