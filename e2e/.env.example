# Copy to .env (gitignored) and fill in. Never commit real values.

# Target: staging (default) or local dev.
BASE_URL=https://basarai-staging.onrender.com

# Existing confirmed account used for brand/keys/generation/history tests
# (already has the Fight Club Academy brand + an active OpenAI key on
# staging). Do not use a new/unconfirmed account for these -- signup and
# email-confirmation are covered by their own dedicated tests.
TEST_USER_EMAIL=test@fightclub.local
TEST_USER_PASSWORD=

# Hosted Supabase project, used only to generate a deterministic
# confirmation link via the Admin API for the signup/email-confirmation
# tests (no real inbox available). SUPABASE_SECRET_KEY is sensitive --
# same key as the app's own backend/.env, never printed or committed.
SUPABASE_URL=https://pbfbarzscosatbwaaucv.supabase.co
SUPABASE_SECRET_KEY=

# Set to "false" to skip the real OpenAI generation test (it costs money
# and calls the live provider). Defaults to running once.
RUN_GENERATION_TEST=true

# Real email configured in the deployed ADMIN_EMAILS allow-list
# (backend/app/core/auth.py). Used only to log in via a generated magic
# link (never touches/needs the account's password) to verify admin
# authorization actually grants access. Leave unset to skip that one test.
ADMIN_TEST_EMAIL=
